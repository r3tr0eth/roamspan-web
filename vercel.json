{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/es/(.*)",
      "headers": [
        { "key": "Content-Language", "value": "es" }
      ]
    },
    {
      "source": "/((?!es/).*)",
      "headers": [
        { "key": "Content-Language", "value": "en" }
      ]
    }
  ]
}
